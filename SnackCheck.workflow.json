              "type": "string",
              "value": "={{ ['a','b','c','d','e'].includes(String($json.body?.product?.nutriscore_grade ?? $json.product?.nutriscore_grade ?? '').toLowerCase()) ? String($json.body?.product?.nutriscore_grade ?? $json.product?.nutriscore_grade).toLowerCase() : 'unknown' }}"
