              "id": "fat",
              "name": "fat_g",
              "type": "number",
              "value": "={{ ($json.body?.product?.nutriments ?? $json.product?.nutriments ?? {})['fat_100g'] }}"
            },
            {
              "id": "energy",
              "name": "energy_kcal",
              "type": "number",
              "value": "={{ ($json.body?.product?.nutriments ?? $json.product?.nutriments ?? {})['energy-kcal_100g'] }}"
