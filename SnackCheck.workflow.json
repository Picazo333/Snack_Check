    {
      "parameters": {
        "content": "Stage 2: fetch Open Food Facts, require status=1, flatten nutrition. Classification/AI not added yet.",
        "height": 220,
        "width": 420,
        "color": 7
      },
      "id": "f55a038d-c9c9-4d8c-87db-31c31dd133ab",
      "name": "Sticky Note Stage 2",
