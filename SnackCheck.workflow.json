      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sugar-flag",
              "name": "sugar_flag",
              "type": "string",
              "value": "={{ Number($json.sugar_g) < 5 ? 'low' : (Number($json.sugar_g) <= 22.5 ? 'medium' : 'high') }}"
            },
            {
              "id": "salt-flag",
              "name": "salt_flag",
              "type": "string",
              "value": "={{ Number($json.salt_g) > 1.5 ? 'high' : 'within_threshold' }}"
            },
            {
              "id": "fat-flag",
              "name": "fat_flag",
              "type": "string",
              "value": "={{ Number($json.fat_g) > 17.5 ? 'high' : 'within_threshold' }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "80e6385b-4dda-4029-864b-3026a9541ed5",
      "name": "Classify - Nutrient Traffic Lights",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2016,
        -208
      ],
      "notes": "UK-style flags: sugar low/medium/high; salt and fat high vs within_threshold. Keeps existing fields."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const sugarHigh = $json.sugar_flag === 'high' ? 1 : 0;\nconst saltHigh = $json.salt_flag === 'high' ? 1 : 0;\nconst fatHigh = $json.fat_flag === 'high' ? 1 : 0;\nreturn {\n  json: Object.assign({}, $json, {\n    concern_score: sugarHigh + saltHigh + fatHigh\n  })\n};\n"
      },
      "id": "4a0f6eee-7785-4aca-a4bf-8d9689a519cd",
      "name": "Calculate - Concern Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        -208
      ],
      "notes": "concern_score is the count of high flags only. It is not the overall verdict."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "tl-reading",
              "name": "traffic_light_reading",
              "type": "string",
              "value": "={{ Number($json.concern_score) === 0 ? 'healthy' : (Number($json.concern_score) === 1 ? 'moderate' : 'unhealthy') }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "fbdea4e1-9459-46f3-aa10-0c44db76d140",
      "name": "Classify - Traffic Light Reading",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2464,
        -208
      ],
      "notes": "Maps concern_score 0/1/2-3 to healthy/moderate/unhealthy."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ns-reading",
              "name": "nutriscore_reading",
              "type": "string",
              "value": "={{ $json.nutriscore_grade === 'a' || $json.nutriscore_grade === 'b' ? 'healthy' : ($json.nutriscore_grade === 'c' ? 'moderate' : ($json.nutriscore_grade === 'd' || $json.nutriscore_grade === 'e' ? 'unhealthy' : 'unknown')) }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "c182faa6-2f5c-4d21-be90-276d175fc0a7",
      "name": "Classify - NutriScore Reading",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2688,
        -208
      ],
      "notes": "a/b healthy, c moderate, d/e unhealthy, else unknown."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "overall",
              "name": "overall_verdict",
              "type": "string",
              "value": "={{ $json.nutriscore_reading === 'unknown' ? $json.traffic_light_reading : (($json.traffic_light_reading === 'unhealthy' || $json.nutriscore_reading === 'unhealthy') ? 'unhealthy' : (($json.traffic_light_reading === 'moderate' || $json.nutriscore_reading === 'moderate') ? 'moderate' : 'healthy')) }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "e691df90-2d5f-483c-b792-1e9a07b3ee33",
      "name": "Decide - Overall Verdict",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2912,
        -208
      ],
      "notes": "Worse of traffic light and Nutri-Score. Unknown Nutri-Score uses traffic light alone."
    },
    {
      "parameters": {
        "content": "Stage 3: traffic-light flags, concern_score (high count only), readings, overall_verdict. No AI.",
        "height": 200,
        "width": 480,
        "color": 3
      },
      "id": "cbce27fa-3f31-4cd2-b6b1-f7b05aad56e9",
      "name": "Sticky Note Stage 3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        2000,
        -416
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sel-enc",
              "name": "selected",
              "type": "boolean",
              "value": "={{ $json.overall_verdict !== 'unhealthy' }}"
            },
            {
              "id": "prompt-enc",
              "name": "ai_prompt",
              "type": "string",
              "value": "=The classification is FINAL and must not be recalculated or changed. Write exactly two short English sentences in an encouraging, friendly tone. If the overall verdict is moderate, acknowledge moderation. Do not use headings, bullets, emojis, or medical advice. Do not invent facts. Use only these facts. Product name: {{ $json.product_name }}. Sugar: {{ $json.sugar_g }} g (flag {{ $json.sugar_flag }}). Salt: {{ $json.salt_g }} g (flag {{ $json.salt_flag }}). Fat: {{ $json.fat_g }} g (flag {{ $json.fat_flag }}). Nutri-Score: {{ $json.nutriscore_grade }}. Traffic-light reading: {{ $json.traffic_light_reading }}. Overall verdict: {{ $json.overall_verdict }}. Concern score: {{ $json.concern_score }}/3."
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "981a2c8d-1237-41af-be07-5b3cd967f695",
      "name": "Prepare - AI Verdict Encouraging",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        3136,
        -320
      ],
      "notes": "Always runs. selected is true when verdict is not unhealthy. Builds encouraging ai_prompt; classification stays FINAL."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sel-caut",
              "name": "selected",
              "type": "boolean",
              "value": "={{ $json.overall_verdict === 'unhealthy' }}"
            },
            {
              "id": "prompt-caut",
              "name": "ai_prompt",
              "type": "string",
              "value": "=The classification is FINAL and must not be recalculated or changed. Write exactly two short English sentences in a gently cautionary tone that is direct but not alarming. When appropriate, frame this as something for occasional consumption. Do not use headings, bullets, emojis, or medical advice. Do not invent facts. Use only these facts. Product name: {{ $json.product_name }}. Sugar: {{ $json.sugar_g }} g (flag {{ $json.sugar_flag }}). Salt: {{ $json.salt_g }} g (flag {{ $json.salt_flag }}). Fat: {{ $json.fat_g }} g (flag {{ $json.fat_flag }}). Nutri-Score: {{ $json.nutriscore_grade }}. Traffic-light reading: {{ $json.traffic_light_reading }}. Overall verdict: {{ $json.overall_verdict }}. Concern score: {{ $json.concern_score }}/3."
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "7774da77-7a30-4691-b7d6-59f94ab63def",
      "name": "Prepare - AI Verdict Cautionary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        3136,
        -80
      ],
      "notes": "Always runs. selected is true only for unhealthy. Builds cautionary ai_prompt; no recalculation."
    },
    {
      "parameters": {},
      "id": "db78ffe7-987f-4a76-b60a-453670d2eac2",
