          "conditions": [
            {
              "id": "nutrition-complete",
              "leftValue": "={{ ($json.sugar_g !== null && $json.sugar_g !== undefined && String($json.sugar_g).trim() !== '' && Number.isFinite(Number($json.sugar_g))) && ($json.salt_g !== null && $json.salt_g !== undefined && String($json.salt_g).trim() !== '' && Number.isFinite(Number($json.salt_g))) && ($json.fat_g !== null && $json.fat_g !== undefined && String($json.fat_g).trim() !== '' && Number.isFinite(Number($json.fat_g))) }}",
